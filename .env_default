# Copy to .env and fill in. Read by app.config.ts at build/start time.
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Google Maps SDK keys (Android, and optionally a separate iOS key)
GOOGLE_MAPS_API_KEY=your_android_maps_key
IOS_GOOGLE_MAPS_API_KEY=

# Local Firebase emulators (development builds only; see docs/firebase/EMULATOR.md).
# When true, the app ignores the FIREBASE_* values above and uses the demo-sbhra
# emulator project. Use your computer's LAN IP as the host for a phone, or
# 10.0.2.2 for the Android emulator.
FIREBASE_USE_EMULATOR=false
FIREBASE_EMULATOR_HOST=127.0.0.1
