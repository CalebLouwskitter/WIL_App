{
  "extends": "expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "baseUrl": "./",
    "paths": {
      "@/*": ["*"],
      "@expo/vector-icons": ["./node_modules/expo/node_modules/@expo/vector-icons"]
    },
    "typeRoots": ["./types", "./node_modules/@types"],
    "skipLibCheck": true
  }
}