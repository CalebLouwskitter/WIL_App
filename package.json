{
  "name": "sbhra_app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check-firebase": "node scripts/checkFirebase.js",
    "check-notifications": "node scripts/checkNotifications.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-sbhra \"jest -c jest.emulator.config.js --runInBand\"",
    "seed:emulator": "node -r ./scripts/registerTs.js scripts/seedEmulator.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.5",
    "@react-navigation/stack": "^7.4.5",
    "expo": "~58.0.17",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.18",
    "expo-media-library": "~58.0.11",
    "expo-notifications": "~58.1.6",
    "expo-sharing": "~58.0.20",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.12",
    "firebase": "^11.3.0",
    "haversine": "^1.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-gifted-charts": "^1.4.63",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-vector-icons": "^10.3.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "~19.3.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-preset-expo": "~58.0.0",
    "dotenv": "^17.2.2",
    "firebase-tools": "15.32.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.12",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@firebase/auth": {
      "@react-native-async-storage/async-storage": "$@react-native-async-storage/async-storage"
    }
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__emulator__/"
    ]
  }
}
