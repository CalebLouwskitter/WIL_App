{
  "name": "sbhra_app",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check-firebase": "node scripts/checkFirebase.js",
    "check-notifications": "node scripts/checkNotifications.js",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:emulator": "firebase emulators:exec --only auth,firestore,storage --project demo-sbhra \"jest -c jest.emulator.config.js --runInBand\"",
    "seed:emulator": "node -r ./scripts/registerTs.js scripts/seedEmulator.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "^7.4.5",
    "@react-navigation/stack": "^7.4.5",
    "expo": "~57.0.31",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.22",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.13",
    "expo-location": "~57.0.22",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.23",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "firebase": "^11.3.0",
    "haversine": "^1.1.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-gifted-charts": "^1.4.63",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-vector-icons": "^10.3.0",
    "xlsx": "^0.18.5",
    "react-dom": "19.2.3",
    "@expo/metro-runtime": "~57.0.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "babel-preset-expo": "~57.0.0",
    "dotenv": "^17.2.2",
    "firebase-tools": "15.32.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/__emulator__/"
    ]
  }
}
